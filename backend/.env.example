# Copy to .env and fill. Never commit .env.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local                 # local | ci | staging | production
APP_LOG_LEVEL=INFO
APP_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Async DSN (asyncpg). docker-compose default below.
DATABASE_URL=postgresql+asyncpg://reorderos:reorderos@localhost:5432/reorderos

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Sprint 2 sets these. Empty in Sprint 1; auth middleware no-ops when unset.
CLERK_JWKS_URL=
CLERK_ISSUER=

# ── POS (Clover) ──────────────────────────────────────────────────────────────
# Sprint 4 sets these.
CLOVER_OAUTH_CLIENT_ID=
CLOVER_OAUTH_CLIENT_SECRET=
CLOVER_WEBHOOK_SIGNING_SECRET=

# ── External services (later sprints) ────────────────────────────────────────
ANTHROPIC_API_KEY=
POSTMARK_TOKEN=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
BETTER_STACK_SOURCE_TOKEN=
