# Copy to .env and fill. Never commit .env.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local                 # local | ci | staging | production
APP_LOG_LEVEL=INFO
APP_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Web server pool (app_user role).
DATABASE_URL=postgresql+asyncpg://reorderos:reorderos@localhost:5433/reorderos

# Service worker pool (service_worker role — webhook handler + inbox worker).
# Same host/db, different role.  Production: use a separate restricted user.
SERVICE_DATABASE_URL=postgresql+asyncpg://service_worker:service_worker@localhost:5433/reorderos

# ── Auth (WorkOS) ─────────────────────────────────────────────────────────────
# Sprint 2: WorkOS AuthKit JWT validation.
# Get these from your WorkOS dashboard → API Keys.
WORKOS_CLIENT_ID=client_...
WORKOS_JWKS_URL=https://api.workos.com/auth/jwks/client_...
WORKOS_ISSUER=https://api.workos.com
WORKOS_VERIFY_AUDIENCE=false   # Set true if WorkOS includes aud claim for your app

# ── POS / Clover (Sprint 4) ───────────────────────────────────────────────────
# Master switch. Default false: the API, receipts pipeline, and workers run
# without any Clover secrets; Clover routes return 503 and the Clover workers
# exit cleanly. Set true only where Clover is intentionally live — that
# restores the fail-closed secret requirements below.
CLOVER_ENABLED=false

# From Clover Developer Dashboard → Your App → App Settings.
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# sandbox | production | eu | latam
CLOVER_ENVIRONMENT=sandbox

# Base URLs — change to production equivalents when going live.
CLOVER_API_BASE_URL=https://apisandbox.dev.clover.com
CLOVER_OAUTH_BASE_URL=https://sandbox.dev.clover.com

# Must match exactly what you registered in Clover Dashboard → App Settings → OAuth Redirect URI.
CLOVER_OAUTH_CALLBACK_URL=https://your-api-domain.com/api/v1/pos/clover/callback

# Where the backend redirects after a successful OAuth handshake.
# Local dev:        reorderos://onboarding/found-summary  (custom scheme, works in dev builds)
# Production:       https://reorderos.com/onboarding/found-summary  (Universal Links, requires live domain + EAS build)
CLOVER_POST_CONNECT_REDIRECT=reorderos://onboarding/found-summary

# Auth code that Clover sends in X-Clover-Auth on every webhook.
# Set in Clover Dashboard → Your App → Webhooks → Auth code.
CLOVER_WEBHOOK_AUTH_CODE=

# ── Token encryption (Fernet) ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY_PREVIOUS: set to old key during rotation, leave blank otherwise.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── External services (later sprints) ────────────────────────────────────────
ANTHROPIC_API_KEY=
POSTMARK_TOKEN=

# ── Postmark inbound email (Sprint 6 Phase 3b) ───────────────────────────────
# OFF by default (webhook 503s). ON requires BOTH Basic Auth halves — they become
# fail-closed at production boot (see app/core/config.py + app/ops/env_check.py).
POSTMARK_INBOUND_ENABLED=false
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
# Base inbound address (Postmark default hash@inbound.postmarkapp.com or custom MX
# domain). Tenant forwarding addresses are local+<token>@domain.
POSTMARK_INBOUND_ADDRESS=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
BETTER_STACK_SOURCE_TOKEN=
